# Copy to .env (ignored by git). Nothing here is needed for demo mode or for `make check`.
# Tests never read .env.

# demo (default): replays recorded model responses, cannot spend.
# live: calls the Anthropic API with the key below. Local only, never on the hosted demo.
APP_MODE=demo

# Needed only when APP_MODE=live, and for the paid spike and recording commands.
ANTHROPIC_API_KEY=
