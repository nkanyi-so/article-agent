{
  "components": {
    "schemas": {
      "Article": {
        "description": "What the ground stage kept and removed, with the transcript sentences it points at.\nDerived from the stored stage records each time; it is not stored twice.",
        "properties": {
          "claims": {
            "items": {
              "$ref": "#/components/schemas/Claim"
            },
            "title": "Claims",
            "type": "array"
          },
          "headline": {
            "$ref": "#/components/schemas/Headline"
          },
          "removed": {
            "items": {
              "$ref": "#/components/schemas/RemovedUnit"
            },
            "title": "Removed",
            "type": "array"
          }
        },
        "required": [
          "headline",
          "claims",
          "removed"
        ],
        "title": "Article",
        "type": "object"
      },
      "CheckResult": {
        "description": "One check's verdict on one run. `score` is the share that passed, 0 to 1.",
        "properties": {
          "detail": {
            "default": [],
            "description": "What failed, in words a person can read.",
            "items": {
              "type": "string"
            },
            "title": "Detail",
            "type": "array"
          },
          "id": {
            "enum": [
              "E1",
              "E2",
              "E3",
              "E4",
              "E5",
              "E6",
              "E7",
              "E8",
              "E9",
              "J1",
              "J1-alone",
              "J2"
            ],
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "passed": {
            "title": "Passed",
            "type": "boolean"
          },
          "score": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Score",
            "type": "number"
          }
        },
        "required": [
          "id",
          "name",
          "passed",
          "score"
        ],
        "title": "CheckResult",
        "type": "object"
      },
      "Citation": {
        "description": "A pointer into the transcript: segments from `start_segment` up to, not including,\n`end_segment`.",
        "properties": {
          "cited_text": {
            "title": "Cited Text",
            "type": "string"
          },
          "end_segment": {
            "minimum": 1.0,
            "title": "End Segment",
            "type": "integer"
          },
          "start_segment": {
            "minimum": 0.0,
            "title": "Start Segment",
            "type": "integer"
          }
        },
        "required": [
          "start_segment",
          "end_segment",
          "cited_text"
        ],
        "title": "Citation",
        "type": "object"
      },
      "Claim": {
        "description": "A sentence of the draft that passed the ground check.",
        "properties": {
          "citations": {
            "items": {
              "$ref": "#/components/schemas/Citation"
            },
            "title": "Citations",
            "type": "array"
          },
          "name_resolutions": {
            "default": [],
            "description": "Names kept by the first-name rule, so the trace shows it.",
            "items": {
              "$ref": "#/components/schemas/NameResolution"
            },
            "title": "Name Resolutions",
            "type": "array"
          },
          "paragraph": {
            "minimum": 0.0,
            "title": "Paragraph",
            "type": "integer"
          },
          "question_segments": {
            "default": [],
            "description": "Added by code, not cited by the model: for each cited line that opens a turn, the question the turn before ended on. Shown to the reader and to the judge as context. Never evidence: no ground rule reads it.",
            "items": {
              "type": "integer"
            },
            "title": "Question Segments",
            "type": "array"
          },
          "segment_indexes": {
            "items": {
              "type": "integer"
            },
            "title": "Segment Indexes",
            "type": "array"
          },
          "text": {
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "text",
          "paragraph",
          "citations",
          "segment_indexes"
        ],
        "title": "Claim",
        "type": "object"
      },
      "ConfigResponse": {
        "properties": {
          "limits": {
            "$ref": "#/components/schemas/Limits"
          },
          "mode": {
            "enum": [
              "demo",
              "live"
            ],
            "title": "Mode",
            "type": "string"
          },
          "paste_enabled": {
            "title": "Paste Enabled",
            "type": "boolean"
          },
          "seeds": {
            "items": {
              "$ref": "#/components/schemas/SeedSummary"
            },
            "title": "Seeds",
            "type": "array"
          }
        },
        "required": [
          "mode",
          "paste_enabled",
          "seeds",
          "limits"
        ],
        "title": "ConfigResponse",
        "type": "object"
      },
      "DocumentPart": {
        "description": "A citable document: one block per transcript sentence, cited by block index.",
        "properties": {
          "blocks": {
            "items": {
              "type": "string"
            },
            "title": "Blocks",
            "type": "array"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "type": {
            "const": "document",
            "default": "document",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "title",
          "blocks"
        ],
        "title": "DocumentPart",
        "type": "object"
      },
      "DraftBlock": {
        "description": "One text block of the draft response, with whatever citations the model attached.",
        "properties": {
          "citations": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/Citation"
            },
            "title": "Citations",
            "type": "array"
          },
          "text": {
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "title": "DraftBlock",
        "type": "object"
      },
      "EvalReport": {
        "description": "The evaluate stage's output for one run.",
        "properties": {
          "checks": {
            "items": {
              "$ref": "#/components/schemas/CheckResult"
            },
            "title": "Checks",
            "type": "array"
          },
          "drafted": {
            "description": "Sentences the model drafted.",
            "title": "Drafted",
            "type": "integer"
          },
          "judge": {
            "$ref": "#/components/schemas/JudgeResult"
          },
          "removal_rate": {
            "title": "Removal Rate",
            "type": "number"
          },
          "removed": {
            "description": "Of those, how many the ground check removed.",
            "title": "Removed",
            "type": "integer"
          }
        },
        "required": [
          "checks",
          "judge",
          "drafted",
          "removed",
          "removal_rate"
        ],
        "title": "EvalReport",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Headline": {
        "description": "The article's headline: the model's if it passed its check, otherwise the title.",
        "properties": {
          "failure": {
            "anyOf": [
              {
                "enum": [
                  "headline_missing",
                  "headline_unsupported_number",
                  "headline_unsupported_name",
                  "headline_misquote",
                  "headline_superseded_number"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Failure"
          },
          "failure_detail": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Failure Detail",
            "type": "array"
          },
          "rejected_text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The model's headline, if it failed.",
            "title": "Rejected Text"
          },
          "source": {
            "enum": [
              "model",
              "title"
            ],
            "title": "Source",
            "type": "string"
          },
          "supporting_claims": {
            "default": [],
            "description": "Indexes into `claims` of the kept sentences that support it.",
            "items": {
              "type": "integer"
            },
            "title": "Supporting Claims",
            "type": "array"
          },
          "text": {
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "text",
          "source"
        ],
        "title": "Headline",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "mode": {
            "enum": [
              "demo",
              "live"
            ],
            "title": "Mode",
            "type": "string"
          },
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          },
          "store": {
            "description": "Whether the database answered.",
            "title": "Store",
            "type": "boolean"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "mode",
          "version",
          "store"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "JudgeResult": {
        "description": "`failed` means the judge could not be used (a refusal, a timeout, an unusable\nresponse). It is plumbing, and is never counted as an unsupported sentence.",
        "properties": {
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "An error code, when it failed.",
            "title": "Error"
          },
          "model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model"
          },
          "outcome": {
            "enum": [
              "judged",
              "failed"
            ],
            "title": "Outcome",
            "type": "string"
          },
          "score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Share of sentences supported.",
            "title": "Score"
          },
          "score_alone": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "The same share when no question is shown with an answer.",
            "title": "Score Alone"
          },
          "verdicts": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/Verdict"
            },
            "title": "Verdicts",
            "type": "array"
          }
        },
        "required": [
          "outcome"
        ],
        "title": "JudgeResult",
        "type": "object"
      },
      "Limits": {
        "properties": {
          "daily_budget_usd": {
            "title": "Daily Budget Usd",
            "type": "number"
          },
          "max_words": {
            "title": "Max Words",
            "type": "integer"
          },
          "min_turns": {
            "title": "Min Turns",
            "type": "integer"
          },
          "min_words": {
            "title": "Min Words",
            "type": "integer"
          },
          "run_ceiling_seconds": {
            "title": "Run Ceiling Seconds",
            "type": "number"
          },
          "runs_per_minute": {
            "title": "Runs Per Minute",
            "type": "integer"
          }
        },
        "required": [
          "min_turns",
          "min_words",
          "max_words",
          "runs_per_minute",
          "daily_budget_usd",
          "run_ceiling_seconds"
        ],
        "title": "Limits",
        "type": "object"
      },
      "ModelRequest": {
        "properties": {
          "content": {
            "items": {
              "discriminator": {
                "mapping": {
                  "document": "#/components/schemas/DocumentPart",
                  "text": "#/components/schemas/TextPart"
                },
                "propertyName": "type"
              },
              "oneOf": [
                {
                  "$ref": "#/components/schemas/TextPart"
                },
                {
                  "$ref": "#/components/schemas/DocumentPart"
                }
              ]
            },
            "title": "Content",
            "type": "array"
          },
          "effort": {
            "enum": [
              "low",
              "medium",
              "high"
            ],
            "title": "Effort",
            "type": "string"
          },
          "max_tokens": {
            "exclusiveMinimum": 0.0,
            "title": "Max Tokens",
            "type": "integer"
          },
          "model": {
            "title": "Model",
            "type": "string"
          },
          "output_schema": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Output Schema"
          },
          "system": {
            "title": "System",
            "type": "string"
          }
        },
        "required": [
          "model",
          "system",
          "content",
          "max_tokens",
          "effort"
        ],
        "title": "ModelRequest",
        "type": "object"
      },
      "ModelResponse": {
        "properties": {
          "attempts": {
            "default": 1,
            "title": "Attempts",
            "type": "integer"
          },
          "blocks": {
            "description": "The text blocks, with any citations.",
            "items": {
              "$ref": "#/components/schemas/DraftBlock"
            },
            "title": "Blocks",
            "type": "array"
          },
          "cost_usd": {
            "title": "Cost Usd",
            "type": "number"
          },
          "latency_ms": {
            "title": "Latency Ms",
            "type": "integer"
          },
          "model": {
            "description": "The model that served the request.",
            "title": "Model",
            "type": "string"
          },
          "parsed": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "description": "The object, when a schema was given.",
            "title": "Parsed"
          },
          "request_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Request Id"
          },
          "stop_reason": {
            "title": "Stop Reason",
            "type": "string"
          },
          "usage": {
            "$ref": "#/components/schemas/Usage"
          }
        },
        "required": [
          "blocks",
          "parsed",
          "stop_reason",
          "model",
          "usage",
          "cost_usd",
          "latency_ms"
        ],
        "title": "ModelResponse",
        "type": "object"
      },
      "NameResolution": {
        "description": "A surname that passed the name check through its owner's first name: the cited text\nhas the first name, and exactly one speaker of the transcript has that first name.",
        "properties": {
          "first_name": {
            "title": "First Name",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "speaker": {
            "title": "Speaker",
            "type": "string"
          }
        },
        "required": [
          "name",
          "first_name",
          "speaker"
        ],
        "title": "NameResolution",
        "type": "object"
      },
      "RemovedUnit": {
        "description": "A sentence the ground check removed. Kept as written, with the reason, never patched.",
        "properties": {
          "detail": {
            "default": [],
            "description": "What was missing, for example the numbers.",
            "items": {
              "type": "string"
            },
            "title": "Detail",
            "type": "array"
          },
          "paragraph": {
            "minimum": 0.0,
            "title": "Paragraph",
            "type": "integer"
          },
          "reason": {
            "enum": [
              "no_citation",
              "invalid_citation",
              "unsupported_number",
              "unsupported_name",
              "misquote",
              "rests_on_corrected_segment"
            ],
            "title": "Reason",
            "type": "string"
          },
          "segment_indexes": {
            "default": [],
            "items": {
              "type": "integer"
            },
            "title": "Segment Indexes",
            "type": "array"
          },
          "text": {
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "text",
          "paragraph",
          "reason"
        ],
        "title": "RemovedUnit",
        "type": "object"
      },
      "ReplayRequest": {
        "properties": {
          "from_stage": {
            "enum": [
              "ingest",
              "extract",
              "draft",
              "ground",
              "evaluate"
            ],
            "title": "From Stage",
            "type": "string"
          }
        },
        "required": [
          "from_stage"
        ],
        "title": "ReplayRequest",
        "type": "object"
      },
      "RunCompleted": {
        "properties": {
          "at": {
            "description": "Server time when the event was produced.",
            "title": "At",
            "type": "string"
          },
          "run_id": {
            "title": "Run Id",
            "type": "string"
          },
          "seq": {
            "minimum": 0.0,
            "title": "Seq",
            "type": "integer"
          },
          "type": {
            "const": "run_completed",
            "default": "run_completed",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "seq",
          "run_id"
        ],
        "title": "RunCompleted",
        "type": "object"
      },
      "RunDetail": {
        "properties": {
          "article": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Article"
              },
              {
                "type": "null"
              }
            ]
          },
          "cost_usd": {
            "title": "Cost Usd",
            "type": "number"
          },
          "evaluation": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/EvalReport"
              },
              {
                "type": "null"
              }
            ],
            "description": "The run's own checks and the judge's verdicts; null until it is evaluated."
          },
          "model_calls": {
            "items": {
              "$ref": "#/components/schemas/StoredModelCall"
            },
            "title": "Model Calls",
            "type": "array"
          },
          "run": {
            "$ref": "#/components/schemas/RunRow"
          },
          "segments": {
            "items": {
              "$ref": "#/components/schemas/Segment"
            },
            "title": "Segments",
            "type": "array"
          },
          "stages": {
            "items": {
              "$ref": "#/components/schemas/StageRecord"
            },
            "title": "Stages",
            "type": "array"
          }
        },
        "required": [
          "run",
          "cost_usd",
          "stages",
          "model_calls",
          "segments",
          "article",
          "evaluation"
        ],
        "title": "RunDetail",
        "type": "object"
      },
      "RunEvent": {
        "description": "One event of a run's stream.",
        "discriminator": {
          "mapping": {
            "run_completed": "#/components/schemas/RunCompleted",
            "run_failed": "#/components/schemas/RunFailed",
            "run_started": "#/components/schemas/RunStarted",
            "stage_completed": "#/components/schemas/StageCompleted",
            "stage_started": "#/components/schemas/StageStarted"
          },
          "propertyName": "type"
        },
        "oneOf": [
          {
            "$ref": "#/components/schemas/RunStarted"
          },
          {
            "$ref": "#/components/schemas/StageStarted"
          },
          {
            "$ref": "#/components/schemas/StageCompleted"
          },
          {
            "$ref": "#/components/schemas/RunCompleted"
          },
          {
            "$ref": "#/components/schemas/RunFailed"
          }
        ],
        "title": "RunEvent"
      },
      "RunFailed": {
        "properties": {
          "at": {
            "description": "Server time when the event was produced.",
            "title": "At",
            "type": "string"
          },
          "error": {
            "description": "An error code. Never exception text or an upstream message.",
            "title": "Error",
            "type": "string"
          },
          "run_id": {
            "title": "Run Id",
            "type": "string"
          },
          "seq": {
            "minimum": 0.0,
            "title": "Seq",
            "type": "integer"
          },
          "stage": {
            "anyOf": [
              {
                "enum": [
                  "ingest",
                  "extract",
                  "draft",
                  "ground",
                  "evaluate"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Stage"
          },
          "type": {
            "const": "run_failed",
            "default": "run_failed",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "seq",
          "run_id",
          "error"
        ],
        "title": "RunFailed",
        "type": "object"
      },
      "RunRow": {
        "description": "A run as listed: enough to find it again and to see how it ended.",
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "mode": {
            "enum": [
              "demo",
              "live"
            ],
            "title": "Mode",
            "type": "string"
          },
          "parent_run_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Parent Run Id"
          },
          "pinned": {
            "default": false,
            "title": "Pinned",
            "type": "boolean"
          },
          "replay_from_stage": {
            "anyOf": [
              {
                "enum": [
                  "ingest",
                  "extract",
                  "draft",
                  "ground",
                  "evaluate"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Replay From Stage"
          },
          "seed_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Seed Id"
          },
          "source": {
            "enum": [
              "seed",
              "paste",
              "replay"
            ],
            "title": "Source",
            "type": "string"
          },
          "status": {
            "enum": [
              "running",
              "completed",
              "failed"
            ],
            "title": "Status",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "id",
          "created_at",
          "mode",
          "source",
          "title",
          "status"
        ],
        "title": "RunRow",
        "type": "object"
      },
      "RunStarted": {
        "properties": {
          "at": {
            "description": "Server time when the event was produced.",
            "title": "At",
            "type": "string"
          },
          "run_id": {
            "title": "Run Id",
            "type": "string"
          },
          "seq": {
            "minimum": 0.0,
            "title": "Seq",
            "type": "integer"
          },
          "type": {
            "const": "run_started",
            "default": "run_started",
